# Clé API Anthropic — tenue uniquement côté serveur (app/api/claude), jamais exposée au navigateur.
ANTHROPIC_API_KEY=

# Optionnel — modèle utilisé pour l'analyse photo et la génération de posts.
# Défaut si absent : claude-sonnet-5
ANTHROPIC_MODEL=

# Mot de passe partagé pour accéder à /outils (l'outil de tri photo).
# Sans cette variable en production, /outils reste bloqué.
ADMIN_PASSWORD=
